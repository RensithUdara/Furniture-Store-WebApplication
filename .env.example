# Copy to .env.local. Never commit real secrets.
# Exact origin the app is served from, no trailing slash (https://your-domain in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used solely by the signature-verified PayHere notification handler.
SUPABASE_SECRET_KEY=

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# sandbox | live. Anything other than "live" uses the sandbox.
PAYHERE_MODE=sandbox

# International format, digits only (e.g. 94771234567).
WHATSAPP_BUSINESS_NUMBER=

# PayHere Refund API
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
ALERT_EMAIL_TO=
CRON_SECRET=
